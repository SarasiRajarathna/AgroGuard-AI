# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=agroguard_super_secret_jwt_key_2026_regional_early_warning
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL Configuration (Optional: In-memory fallback is fully functional if empty)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Vision & Multilingual Diagnosis Engine
# Gemini Vision API Key (Optional: Authentic PlantVillage visual pathology classifier runs when key is unset)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# Regional Epidemiological Outbreak Thresholds
OUTBREAK_RADIUS_KM=10
OUTBREAK_MIN_CASES=3
CONFIDENCE_HIGH_THRESHOLD=90
CONFIDENCE_LOW_THRESHOLD=75
